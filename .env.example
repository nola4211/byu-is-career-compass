# Public Worker URL embedded into the static GitHub Pages build. This is not a
# credential. Set the same key as a GitHub Actions repository variable.
VITE_LIVEKIT_TOKEN_ENDPOINT=http://localhost:8787

# Values below belong only in the separately deployed token Worker. The
# connection URL is not secret; API credentials are secrets.
LIVEKIT_URL=wss://is-core-case-2026-zat9gox0.livekit.cloud

# Server-only credentials. Add real values to the hosting environment; never
# commit them or expose them through a VITE_ variable.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Fixed deployed agent name and the browser origin allowed to request tokens.
LIVEKIT_AGENT_NAME=career-interviewer
LIVEKIT_ALLOWED_ORIGIN=https://nola4211.github.io
